{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novavpn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c970151b-46d1-4946-af29-c73688e69f1f","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d6272138b7b04497b04e6bb3b080328b" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
